<?php

/**
 * @file
 * Main module file for Domain Menu Item.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function domain_menu_item_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.domain_menu_item':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The Domain Menu Item module allows you to associate menu items with specific domains from the Domain module.') . '</p>';
      $output .= '<h3>' . t('Uses') . '</h3>';
      $output .= '<dl>';
      $output .= '<dt>' . t('Managing menu items per domain') . '</dt>';
      $output .= '<dd>' . t('When editing a menu item, you can select one or more domains where this menu item should appear.') . '</dd>';
      $output .= '</dl>';
      return $output;
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for menu_link_content_form.
 */
function domain_menu_item_form_menu_link_content_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $menu_link = $form_state->getFormObject()->getEntity();

  // Load domain storage.
  $domain_storage = \Drupal::entityTypeManager()->getStorage('domain');
  $domains = $domain_storage->loadMultipleSorted();

  if (empty($domains)) {
    return;
  }

  // Prepare domain options.
  $options = [];
  foreach ($domains as $domain) {
    $options[$domain->id()] = $domain->label();
  }

  // Load existing domain selections.
  $default_values = [];
  if (!$menu_link->isNew()) {
    $database = \Drupal::database();
    $query = $database->select('domain_menu_item', 'd')
      ->fields('d', ['domain_id'])
      ->condition('menu_link_content_id', $menu_link->id());
    $results = $query->execute()->fetchCol();
    $default_values = $results ?: [];
  }

  // Add domain selection field.
  $form['domain_selection'] = [
    '#type' => 'checkboxes',
    '#title' => t('Show on domains'),
    '#description' => t('Select the domains where this menu item should appear. Leave empty to show on all domains.'),
    '#options' => $options,
    '#default_value' => $default_values,
    '#weight' => 50,
  ];

  // Add custom submit handler.
  $form['actions']['submit']['#submit'][] = 'domain_menu_item_form_submit';
}

/**
 * Custom submit handler for menu link content form.
 */
function domain_menu_item_form_submit(&$form, FormStateInterface $form_state) {
  $menu_link = $form_state->getFormObject()->getEntity();
  $domain_selection = $form_state->getValue('domain_selection');

  if (!$menu_link->id()) {
    return;
  }

  $database = \Drupal::database();

  // Delete existing associations.
  $database->delete('domain_menu_item')
    ->condition('menu_link_content_id', $menu_link->id())
    ->execute();

  // Insert new associations.
  if (!empty($domain_selection)) {
    foreach ($domain_selection as $domain_id => $selected) {
      if ($selected) {
        $database->insert('domain_menu_item')
          ->fields([
            'menu_link_content_id' => $menu_link->id(),
            'domain_id' => $domain_id,
          ])
          ->execute();
      }
    }
  }

  // Invalidate the domain menu item cache.
  \Drupal\Core\Cache\Cache::invalidateTags(['domain_menu_item']);

  // Also invalidate menu cache to ensure changes appear immediately.
  \Drupal::service('plugin.manager.menu.link')->rebuild();
}

/**
 * Implements hook_preprocess_menu().
 */
function domain_menu_item_preprocess_menu(&$variables) {
  // Don't filter menus on admin pages - admins need to see all menu items.
  $route_match = \Drupal::routeMatch();
  $is_admin = \Drupal::service('router.admin_context')->isAdminRoute($route_match->getRouteObject());

  if ($is_admin) {
    return;
  }

  // Get the current domain.
  $domain_negotiator = \Drupal::service('domain.negotiator');
  $active_domain = $domain_negotiator->getActiveDomain();

  if (!$active_domain) {
    return;
  }

  // Get domain restrictions for all menu links (cached).
  $domain_restrictions = _domain_menu_item_get_restrictions();

  if (empty($domain_restrictions)) {
    return;
  }

  // Filter menu items recursively.
  _domain_menu_item_filter_items($variables['items'], $domain_restrictions, $active_domain->id());
}

/**
 * Helper function to get domain restrictions (with caching).
 */
function _domain_menu_item_get_restrictions() {
  $cid = 'domain_menu_item:restrictions';
  $cache = \Drupal::cache()->get($cid);

  if ($cache) {
    return $cache->data;
  }

  $database = \Drupal::database();
  $query = $database->select('domain_menu_item', 'd')
    ->fields('d', ['menu_link_content_id', 'domain_id']);
  $results = $query->execute()->fetchAll();

  // Group by menu link content id.
  $domain_restrictions = [];
  foreach ($results as $row) {
    $domain_restrictions[$row->menu_link_content_id][] = $row->domain_id;
  }

  // Cache the restrictions.
  \Drupal::cache()->set($cid, $domain_restrictions, \Drupal\Core\Cache\Cache::PERMANENT, ['domain_menu_item']);

  return $domain_restrictions;
}

/**
 * Recursively filter menu items based on domain restrictions.
 */
function _domain_menu_item_filter_items(&$items, $domain_restrictions, $active_domain_id) {
  foreach ($items as $key => &$item) {
    // Check if this is a menu_link_content item.
    if (isset($item['url']) && $item['url'] instanceof \Drupal\Core\Url) {
      $route_parameters = $item['url']->getRouteParameters();

      // Try to get the menu link content entity ID.
      if (isset($route_parameters['menu_link_content'])) {
        $menu_link_id = $route_parameters['menu_link_content'];
      }
      else {
        // Try to extract from the original link.
        $original_link = $item['original_link'] ?? NULL;
        if ($original_link && method_exists($original_link, 'getPluginId')) {
          $plugin_id = $original_link->getPluginId();
          if (strpos($plugin_id, 'menu_link_content:') === 0) {
            $uuid = str_replace('menu_link_content:', '', $plugin_id);
            // Load entity to get numeric ID.
            $entities = \Drupal::entityTypeManager()
              ->getStorage('menu_link_content')
              ->loadByProperties(['uuid' => $uuid]);
            if ($entities) {
              $entity = reset($entities);
              $menu_link_id = $entity->id();
            }
          }
        }
      }

      // If we have a menu link ID and it has domain restrictions.
      if (isset($menu_link_id) && isset($domain_restrictions[$menu_link_id])) {
        $allowed_domains = $domain_restrictions[$menu_link_id];

        // If current domain is not in the allowed list, remove this item.
        if (!in_array($active_domain_id, $allowed_domains, TRUE)) {
          unset($items[$key]);
          continue;
        }
      }
    }

    // Recursively process child items.
    if (!empty($item['below'])) {
      _domain_menu_item_filter_items($item['below'], $domain_restrictions, $active_domain_id);

      // If all children were removed, remove the 'below' key.
      if (empty($item['below'])) {
        unset($item['below']);
      }
    }
  }
}

/**
 * Implements hook_entity_delete().
 */
function domain_menu_item_entity_delete(Drupal\Core\Entity\EntityInterface $entity) {
  // Clean up domain associations when a menu link is deleted.
  if ($entity->getEntityTypeId() === 'menu_link_content') {
    \Drupal::database()->delete('domain_menu_item')
      ->condition('menu_link_content_id', $entity->id())
      ->execute();

    // Invalidate the domain menu item cache.
    \Drupal\Core\Cache\Cache::invalidateTags(['domain_menu_item']);
  }
}
